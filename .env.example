# Golden Horizon Research — environment configuration
# Copy to ".env" and fill in to point the catalog at a live WooCommerce store.
# Leave unset to run on the bundled sample catalog (the default demo behaviour).

# Base URL of your WooCommerce site (no trailing slash). The browser-safe,
# read-only Store API lives at <URL>/wp-json/wc/store/v1.
# Example: https://store.goldenhorizon.example
VITE_WC_STORE_URL=

# Optional: how many products to request from the Store API (default 24).
VITE_WC_PER_PAGE=24
